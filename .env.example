# ---------------------------------------------------------------------------
# Public (safe to expose to the browser — these are the ONLY NEXT_PUBLIC_ vars)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only secrets. NEVER prefix these with NEXT_PUBLIC_ and never import
# them from a file that runs in the browser. They are read exclusively from
# `src/lib/env.ts`, which throws if it is evaluated client-side.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
CLAUDE_MODEL=claude-opus-5
CLAUDE_MAX_TOKENS=16000
CLAUDE_EFFORT=high

# ---------------------------------------------------------------------------
# Public (safe to expose to the browser — these are the ONLY NEXT_PUBLIC_ vars)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only secrets. NEVER prefix these with NEXT_PUBLIC_ and never import
# them from a file that runs in the browser. They are read exclusively from
# `src/lib/env.ts`, which throws if it is evaluated client-side.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
CLAUDE_MODEL=claude-opus-5
CLAUDE_MAX_TOKENS=16000
CLAUDE_EFFORT=high

# ---------------------------------------------------------------------------
# GitHub App (optional). Leave unset to run without the repository feature —
# the repo panel then shows "GitHub is not configured" and nothing else changes.
#
# Create a GitHub App (Settings > Developer settings > GitHub Apps) with:
#   - Repository permissions: Contents = Read and write, Pull requests = Read
#     and write, Metadata = Read-only.
#   - Setup URL: https://your-site/github/setup  (check "Redirect on update").
#   - No webhook is required for this integration.
# Then generate a private key and paste it below (escaped newlines or base64
# both work). These are server-only — never prefix them with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=your-app-slug
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# GitHub sign-in (optional, separate from the App). Enable the GitHub provider
# in Supabase Auth and set its OAuth callback to
# https://your-project.supabase.co/auth/v1/callback — no app env var is needed
# here because Supabase holds the OAuth client secret.
